# ── 服务监听 ──────────────────────────────────────────
HOST=0.0.0.0
PORT=9527

# ── SQLite ────────────────────────────────────────────
SQLITE_PATH=./data/customer.db

# ── JWT ───────────────────────────────────────────────
JWT_SECRET_KEY=请填写与原后台相同的密钥
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=15

# ── 微信登录 ──────────────────────────────────────────
WX_APPID=请填写
WX_SECRET=请填写

# ── SiliconFlow AI ────────────────────────────────────
SILICONFLOW_API_KEY=请填写
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/chat/completions
