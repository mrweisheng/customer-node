# ── 服务监听 ──────────────────────────────────────────
HOST=0.0.0.0
PORT=9527

# ── SQLite ────────────────────────────────────────────
SQLITE_PATH=./data/customer.db

# ── JWT ───────────────────────────────────────────────
JWT_SECRET_KEY=请填写与原后台相同的密钥
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=15

# ── 微信登录 ──────────────────────────────────────────
WX_APPID=请填写
WX_SECRET=请填写

# ── AI 识别限流 ───────────────────────────────────────
AI_RATE_LIMIT_WINDOW=60
AI_RATE_LIMIT_MAX=30

# ── MiniMax M3（唯一 LLM：agent 对话 + 截图识别统一走这里）─────
# key 不要进任何源文件、不要 commit；填到 .env 后请到控制台 rotate
# 中国大陆端点：https://api.minimaxi.com/v1/chat/completions
# thinking: disabled 节省 token、降低延迟（agent 任务不需要深度思考）
LLM_API_URL=https://api.minimaxi.com/v1/chat/completions
LLM_MODEL=MiniMax-M3
LLM_API_KEY=请填写
LLM_THINKING=disabled
LLM_MAX_TOKENS=8192
LLM_MAX_TOOL_ITER=5

# ── 迁移脚本专用（迁完可删）────────────────────────────
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
